# DMflow Instagram Automation Platform — Environment Variables

# 1. Supabase Client & Admin Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Meta Instagram Business Login OAuth Credentials
NEXT_PUBLIC_INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
NEXT_PUBLIC_INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/callback

# 3. Meta Instagram Webhook Handshake & Verification Token
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=dmflow_secret_token_123

# 4. Groq AI API Key (Llama 3.1 8B Instant)
GROQ_API_KEY=gsk_your_free_groq_api_key
